@model Estudio
@{
    ViewData["Title"] = "Eliminar estudio";
}

<h1>Eliminar estudio</h1>

<div class="alert alert-warning">
    ¿Seguro que desea eliminar el estudio de <strong>@Model.IdProfNavigation.Nom</strong>
    de <strong>@Model.CcPerNavigation.Nombre @Model.CcPerNavigation.Apellido</strong>?
</div>

<form asp-action="Delete">
    <input type="hidden" name="idProf" value="@Model.IdProf" />
    <input type="hidden" name="ccPer" value="@Model.CcPer" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
