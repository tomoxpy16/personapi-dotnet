@model Profesion
@{
    ViewData["Title"] = "Eliminar profesión";
}

<h1>Eliminar profesión</h1>

<div class="alert alert-warning">
    ¿Seguro que desea eliminar <strong>@Model.Nom</strong> (id @Model.Id)?
    También se eliminarán los @Model.Estudios.Count estudio(s) que la referencian.
</div>

<form asp-action="Delete" asp-route-id="@Model.Id">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
