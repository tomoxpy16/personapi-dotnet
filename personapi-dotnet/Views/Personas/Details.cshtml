@model Persona
@{
    ViewData["Title"] = "Detalle de persona";
}

<h1>@Model.Nombre @Model.Apellido</h1>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Cc)</dt>
    <dd class="col-sm-10">@Model.Cc</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Genero)</dt>
    <dd class="col-sm-10">@Model.Genero</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Edad)</dt>
    <dd class="col-sm-10">@(Model.Edad?.ToString() ?? "-")</dd>
</dl>

<h4>Teléfonos</h4>
@if (Model.Telefonos.Any())
{
    <ul>
        @foreach (var t in Model.Telefonos)
        {
            <li>@t.Num (@t.Oper)</li>
        }
    </ul>
}
else
{
    <p class="text-muted">Sin teléfonos registrados.</p>
}

<h4>Estudios</h4>
@if (Model.Estudios.Any())
{
    <ul>
        @foreach (var e in Model.Estudios)
        {
            <li>@e.IdProfNavigation.Nom - @e.Univer @(e.Fecha?.ToString("yyyy-MM-dd"))</li>
        }
    </ul>
}
else
{
    <p class="text-muted">Sin estudios registrados.</p>
}

<a asp-action="Edit" asp-route-id="@Model.Cc" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-link">Volver</a>
