@model IEnumerable<Persona>
@{
    ViewData["Title"] = "Personas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Personas</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva persona</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Cc)</th>
            <th>@Html.DisplayNameFor(m => m.Nombre)</th>
            <th>@Html.DisplayNameFor(m => m.Apellido)</th>
            <th>@Html.DisplayNameFor(m => m.Genero)</th>
            <th>@Html.DisplayNameFor(m => m.Edad)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Cc</td>
                <td>@p.Nombre</td>
                <td>@p.Apellido</td>
                <td>@p.Genero</td>
                <td>@p.Edad</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@p.Cc">Ver</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Cc">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.Cc">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
