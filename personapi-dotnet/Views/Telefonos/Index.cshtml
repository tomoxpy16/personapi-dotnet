@model IEnumerable<Telefono>
@{
    ViewData["Title"] = "Teléfonos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Teléfonos</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo teléfono</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Num)</th>
            <th>@Html.DisplayNameFor(m => m.Oper)</th>
            <th>@Html.DisplayNameFor(m => m.Duenio)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Num</td>
                <td>@t.Oper</td>
                <td>@t.Duenio - @t.DuenioNavigation.Nombre @t.DuenioNavigation.Apellido</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@t.Num">Ver</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@t.Num">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@t.Num">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
