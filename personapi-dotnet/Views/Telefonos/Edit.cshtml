@model Telefono
@{
    ViewData["Title"] = "Editar teléfono";
}

<h1>Editar teléfono</h1>

<form asp-action="Edit" asp-route-id="@Model.Num" class="col-md-6">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-link">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
